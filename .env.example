# Public browser configuration. Google Identity Services Web OAuth Client ID (public).
VITE_GOOGLE_OAUTH_CLIENT_ID=

# Backend API URL including /api/v1. Use http://127.0.0.1:8014/api/v1 for local dev.
# For production, set to https://<your-render-backend>.onrender.com/api/v1
VITE_API_BASE_URL=http://127.0.0.1:8014/api/v1
