PROTEVA_ENV=development
PROTEVA_DATABASE_PATH=./proteva-dev.sqlite3
# Server-only Gemma credential. Never use VITE_ variables for this value.
PROTEVA_GOOGLE_API_KEY=
# Google Identity Services Web client ID. This public identifier must match
# VITE_GOOGLE_OAUTH_CLIENT_ID in the Vercel project.
PROTEVA_GOOGLE_OAUTH_CLIENT_ID=
# Generate a separate 32+ byte random value. Never use the Gemini API key here.
PROTEVA_AUTH_SIGNING_SECRET=
PROTEVA_AUTH_TOKEN_TTL_SECONDS=3600
# Comma-separated Vercel application origins, required in production.
PROTEVA_CORS_ORIGINS=
PROTEVA_GEMMA_MODEL=gemma-4-26b-a4b-it
# Native ProteinMPNN environment created by fast_screening/README.md.
PROTEVA_PROTEINMPNN_PYTHON=../fast_screening/.venv/Scripts/python.exe

# Pinned upstream checkout, controlled artifact storage, and prepared 4AKE/1AKE inputs.
PROTEVA_PROTEINMPNN_SOURCE=../fast_screening/third_party/ProteinMPNN
PROTEVA_PROTEINMPNN_ARTIFACTS=../fast_screening/artifacts
PROTEVA_PREPARED_STRUCTURES=../fast_screening/structures
